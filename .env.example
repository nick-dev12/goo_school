# Copier ce fichier vers .env pour activer le temps réel en développement local
# copy .env.example .env   (Windows)

DEBUG=True

# Base PostgreSQL locale (WAMP) — sur le VPS utiliser goo_school
DB_NAME=aria
DB_USER=postgres
DB_PASSWORD=Ludvanne
DB_HOST=localhost
DB_PORT=5432

# Temps réel local — Redis requis sur le port 6379 (Memurai ou WSL)
REALTIME_LOCAL=True
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=True
USE_REDIS_CACHE=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

SITE_URL=http://127.0.0.1:8000

# Assistant vocal directeur (ne jamais committer les clés réelles)
ASSISTANT_LLM_PROVIDER=gemini
ASSISTANT_TTS_BACKEND=gemini
GEMINI_API_KEY=
# gemini-2.5-flash n'est plus disponible pour les nouvelles clés Google AI
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
# Voix féminine Gemini Studio (Kore)
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=fr-FR
# false = une seule voix Gemini (Edge = timbre différent + artefacts possibles)
ASSISTANT_TTS_FALLBACK_EDGE=false
GEMINI_CONTEXT_CACHE=true
GEMINI_CACHE_TTL_SECONDS=7200

# Rollback LLM / voix (optionnel)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EDGE_TTS_VOICE=fr-FR-EloiseNeural
