# Copier ce fichier vers .env pour activer le temps réel en développement local
# copy .env.example .env   (Windows)

DEBUG=True

# Base PostgreSQL locale (WAMP) — sur le VPS utiliser goo_school
DB_NAME=aria
DB_USER=postgres
DB_PASSWORD=Ludvanne
DB_HOST=localhost
DB_PORT=5432

# Temps réel local — Redis requis sur le port 6379 (Memurai ou WSL)
REALTIME_LOCAL=True
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=True
USE_REDIS_CACHE=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

SITE_URL=http://127.0.0.1:8000
