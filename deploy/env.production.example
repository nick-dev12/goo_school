# Variables d'environnement — production VPS (temps réel)
# Copier vers /etc/aria/env ou .env à la racine du projet

DEBUG=False
SECRET_KEY=changez-moi-en-production

DB_NAME=aria
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (broker Celery + Channel Layer + cache)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
USE_CELERY=True
USE_REDIS_CACHE=True

SITE_URL=https://aria-edu.com
